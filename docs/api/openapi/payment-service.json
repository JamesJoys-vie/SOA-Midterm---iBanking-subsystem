{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Service",
    "version": "0.1.0"
  },
  "paths": {
    "/accounts/me": {
      "get": {
        "summary": "My Account",
        "operationId": "my_account_accounts_me_get",
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountOut"
                }
              }
            }
          },
          "404": {
            "description": "No account"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions": {
      "get": {
        "summary": "History",
        "description": "Transaction history of the authenticated user (newest first).",
        "operationId": "history_transactions_get",
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransactionOut"
                  },
                  "title": "Response History Transactions Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Initiate",
        "description": "SAGA step 1: reserve the tuition, create a PENDING_OTP transaction, email an OTP.\nRe-sending the same Idempotency-Key returns the original transaction without side effects.",
        "operationId": "initiate_transactions_post",
        "parameters": [
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-User-Id"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InitiateTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionOut"
                }
              }
            }
          },
          "400": {
            "description": "Bad input"
          },
          "404": {
            "description": "Student/tuition not found"
          },
          "409": {
            "description": "Tuition already paid/reserved"
          },
          "422": {
            "description": "Insufficient balance"
          },
          "502": {
            "description": "Dependency down"
          }
        }
      }
    },
    "/transactions/{transaction_id}/verify-otp": {
      "post": {
        "summary": "Verify Otp",
        "description": "SAGA step 2: verify OTP, debit, mark the tuition paid. Business outcomes come back as 200 with the\ntransaction status: SUCCESS, FAILED (e.g. insufficient balance, see failure_reason) or PROCESSING (finishing).",
        "operationId": "verify_otp_transactions__transaction_id__verify_otp_post",
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Transaction Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-User-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid/expired OTP"
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Conflict"
          },
          "410": {
            "description": "Transaction expired"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transaction_id}": {
      "get": {
        "summary": "Get Transaction",
        "description": "Poll a single transaction (e.g. while it is PROCESSING, or to resume a PENDING_OTP one).",
        "operationId": "get_transaction_transactions__transaction_id__get",
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Transaction Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionOut"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transaction_id}/resend-otp": {
      "post": {
        "summary": "Resend Otp",
        "description": "New OTP (the previous one stops working); the transaction's OTP window restarts.",
        "operationId": "resend_otp_transactions__transaction_id__resend_otp_post",
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Transaction Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendOtpResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Not waiting for OTP"
          },
          "410": {
            "description": "Transaction expired"
          },
          "429": {
            "description": "Too many requests"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/transactions/{transaction_id}/cancel": {
      "post": {
        "summary": "Cancel",
        "description": "Cancel a PENDING_OTP transaction and release the tuition reservation.",
        "operationId": "cancel_transactions__transaction_id__cancel_post",
        "parameters": [
          {
            "name": "transaction_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Transaction Id"
            }
          },
          {
            "name": "x-user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionOut"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "409": {
            "description": "Not cancellable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountOut": {
        "properties": {
          "balance": {
            "type": "string",
            "title": "Balance"
          }
        },
        "type": "object",
        "required": [
          "balance"
        ],
        "title": "AccountOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InitiateTransactionRequest": {
        "properties": {
          "student_id": {
            "type": "string",
            "title": "Student Id",
            "description": "MSSV to pay for"
          },
          "term": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Term"
          }
        },
        "type": "object",
        "required": [
          "student_id"
        ],
        "title": "InitiateTransactionRequest"
      },
      "ResendOtpResult": {
        "properties": {
          "otp_expires_in": {
            "type": "integer",
            "title": "Otp Expires In"
          }
        },
        "type": "object",
        "required": [
          "otp_expires_in"
        ],
        "title": "ResendOtpResult"
      },
      "TransactionOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "student_id": {
            "type": "string",
            "title": "Student Id"
          },
          "amount": {
            "type": "string",
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "otp_expires_in": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Otp Expires In"
          }
        },
        "type": "object",
        "required": [
          "id",
          "student_id",
          "amount",
          "status",
          "created_at"
        ],
        "title": "TransactionOut"
      },
      "TransactionResult": {
        "properties": {
          "transaction": {
            "$ref": "#/components/schemas/TransactionOut"
          },
          "balance_after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Balance After"
          }
        },
        "type": "object",
        "required": [
          "transaction"
        ],
        "title": "TransactionResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerifyOtpRequest": {
        "properties": {
          "otp": {
            "type": "string",
            "maxLength": 6,
            "minLength": 6,
            "title": "Otp"
          }
        },
        "type": "object",
        "required": [
          "otp"
        ],
        "title": "VerifyOtpRequest"
      }
    }
  }
}
