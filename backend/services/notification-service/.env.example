# Copy this file to .env and replace every "change-me".
# .env is read by Docker Compose (env_file) or by: uvicorn app.main:app --env-file .env
# Make a random secret with:  python -c "import secrets; print(secrets.token_hex(32))"

# PostgreSQL for notification-service only (its own database).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://ibanking:ibanking@localhost:5432/notification

# Token otp-service and payment-service send in the X-Internal-Token header.
# Random secret; put the SAME value in otp-service (NOTIFICATION_TOKEN) and payment-service.
INTERNAL_API_TOKEN=change-me

# Mail server. Defaults fit Mailpit (port 1025, no login, no TLS).
# In Docker Compose, SMTP_HOST is the Mailpit service name, e.g. mailpit.
SMTP_HOST=localhost
SMTP_PORT=1025
# Leave empty for Mailpit; fill in for a real mail server.
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# Sender shown in every email.
MAIL_FROM=iBanking <no-reply@ibanking.local>

# How many times, and how many seconds apart, to retry reaching the database at startup.
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_SECONDS=2
