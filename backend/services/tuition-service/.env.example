# URL kết nối cơ sở dữ liệu riêng của tuition-service
# - Môi trường cục bộ / kiểm thử: sqlite:///./tuition.db
# - Chạy Docker Compose MySQL: mysql+pymysql://tuition_svc:tuition_pass@mysql:3306/tuition_db
DATABASE_URL=sqlite:///./tuition.db

# Thời gian giữ chỗ (khóa) học phí cho một giao dịch tính bằng giây
# Mặc định 600 giây (10 phút) để người nộp có đủ thời gian nhập OTP
RESERVATION_TTL_SECONDS=600

# Cổng chạy ứng dụng
PORT=8000
