# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR TUITION-SERVICE
# Assigned Member: Nguyen Duc Hieu (524H0087)
# ==============================================================================

# Database connection URL for tuition-service isolated database
# - Local / Unit test environment: sqlite:///./tuition.db
# - Docker Compose MySQL: mysql+pymysql://tuition_svc:tuition_pass@mysql:3306/tuition_db
DATABASE_URL=sqlite:///./tuition.db

# Tuition reservation hold duration in seconds (safety TTL)
# Default is 600 seconds (10 minutes) so payer has enough time to enter OTP
RESERVATION_TTL_SECONDS=600

# Service running port
PORT=8000
