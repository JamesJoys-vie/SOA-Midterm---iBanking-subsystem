# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR USER-SERVICE
# Assigned Member: Nguyen Duc Hieu (524H0087)
# ==============================================================================

# Database connection URL
# - Local development / testing: sqlite:///./users.db
# - Docker Compose MySQL: mysql+pymysql://user_svc:user_pass@mysql:3306/users_db
DATABASE_URL=sqlite:///./users.db

# Secret key used for signing and verifying JWT tokens (HS256)
JWT_SECRET=super-secret-jwt-key-for-ibanking-subsystem-2026

# JWT token TTL in minutes (default: 30 minutes)
JWT_EXPIRE_MINUTES=30

# Service port
PORT=8000
