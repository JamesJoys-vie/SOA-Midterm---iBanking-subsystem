# URL kết nối cơ sở dữ liệu (Database URL)
# - Chạy cục bộ / kiểm thử: sqlite:///./users.db
# - Chạy Docker Compose MySQL: mysql+pymysql://user_svc:user_pass@mysql:3306/users_db
DATABASE_URL=sqlite:///./users.db

# Khóa bí mật dùng để ký và xác thực JWT token (HS256)
JWT_SECRET=super-secret-jwt-key-for-ibanking-subsystem-2026

# Thời hạn hiệu lực của JWT token (phút), mặc định 30 phút theo yêu cầu
JWT_EXPIRE_MINUTES=30

# Cổng lắng nghe của service
PORT=8000
