# Copy this file to .env and replace every "change-me".
# .env is read by Docker Compose (env_file) or by: uvicorn app.main:app --env-file .env
# Make a random secret with:  python -c "import secrets; print(secrets.token_hex(32))"

# PostgreSQL for otp-service only (its own database).
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql+psycopg://ibanking:ibanking@localhost:5432/otp

# Token payment-service sends in the X-Internal-Token header.
# Random secret; put the SAME value in payment-service's config.
INTERNAL_API_TOKEN=change-me

# Key used to hash OTP codes. Random secret, used only here.
# Keep it the same across restarts, or OTPs already sent stop working.
OTP_SECRET=change-me

# How long an OTP is valid, in seconds (max 300 = 5 minutes).
OTP_TTL_SECONDS=300
# Number of digits in the code.
OTP_LENGTH=6
# Wrong tries allowed before the OTP is locked.
OTP_MAX_ATTEMPTS=3
# Seconds the user must wait before asking for a new code.
OTP_RESEND_COOLDOWN_SECONDS=60
# Codes one transaction can receive in total (first one + resends).
OTP_MAX_SENDS=5

# notification-service, which emails the code.
# In Docker Compose, use its service name, e.g. http://notification-service:8000
NOTIFICATION_URL=http://localhost:8001
# Must be the SAME value as notification-service's INTERNAL_API_TOKEN.
NOTIFICATION_TOKEN=change-me
NOTIFICATION_TIMEOUT_SECONDS=10

# How many times, and how many seconds apart, to retry reaching the database at startup.
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_SECONDS=2