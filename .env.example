# Copy to .env and fill in. NEVER commit .env.

# --- MySQL ---
# Any strong passwords you invent; they just need to be consistent within this .env.
MYSQL_ROOT_PASSWORD=change_me_root
USER_DB_PASSWORD=change_me_user
TUITION_DB_PASSWORD=change_me_tuition
PAYMENT_DB_PASSWORD=change_me_payment
# Port exposed on your machine (3307 avoids clashing with a local MySQL on 3306)
MYSQL_HOST_PORT=3307

# --- Auth / timing ---
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE_MINUTES=30
OTP_TTL_SECONDS=300
RESERVATION_TTL_SECONDS=600

# payment-service processes (it is CPU-bound under load; see docs/reports/LOAD_TEST_REPORT.md)
PAYMENT_WORKERS=4

# SMTP (Mailtrap for dev, or Gmail App Password)
# Mailtrap: sign up at mailtrap.io -> Email Testing -> Inboxes -> SMTP Settings.
#   Keep host/port below; copy that inbox's Username and Password into the two fields.
#   Emails never reach real people; view them in the Mailtrap inbox (good for testing OTP).
# Gmail alternative: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_USER=your full Gmail address, SMTP_PASSWORD=16-char App Password
#   (needs 2-Step Verification on; create at myaccount.google.com/apppasswords - NOT your login password).
SMTP_HOST=sandbox.smtp.mailtrap.io
# 587 / 25 / 2525 = STARTTLS; 465 = implicit TLS (SSL)
SMTP_PORT=587
# Mailtrap inbox username (random string like "a1b2c3d4e5f6g7") or Gmail address
SMTP_USER=
# Mailtrap inbox password or Gmail App Password
SMTP_PASSWORD=
# Sender shown on emails. Any address works with Mailtrap; with Gmail use the same address as SMTP_USER.
SMTP_FROM=ibanking@example.com

# Port the web UI is served on: http://localhost:8080
WEB_HOST_PORT=8080

# Ngrok (only used with: docker compose --profile public up)
# Authtoken: dashboard.ngrok.com -> Getting Started -> Your Authtoken
NGROK_AUTHTOKEN=
# Free static domain: dashboard.ngrok.com -> Universal Gateway -> Domains -> create one
NGROK_DOMAIN=your-name.ngrok-free.app
